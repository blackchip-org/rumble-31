#!/usr/bin/env node
// Thin launcher: re-execs src/main.ts as a real subprocess (rather than
// importing it) so process.argv[1] resolves to main.ts itself, matching
// what `node src/main.ts` gives it directly — that's what main.ts uses
// to decide whether it's being run as the entry point.
import { spawnSync } from "node:child_process";
import { dirname, join } from "node:path";
import { fileURLToPath } from "node:url";

const mainPath = join(dirname(fileURLToPath(import.meta.url)), "..", "src", "main.ts");
const result = spawnSync(process.execPath, [mainPath, ...process.argv.slice(2)], {
  stdio: "inherit",
});
process.exit(result.status ?? 1);
