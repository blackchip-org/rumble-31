{
  "name": "rumble-31",
  "version": "0.1.0",
  "private": true,
  "description": "Rumble-31 card game engine, playable in the browser.",
  "type": "module",
  "scripts": {
    "prepare": "node scripts/gen-buildtime.mjs && node scripts/gen-licenses.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test 'src/**/*.test.ts'",
    "simulate": "node src/sim/cli.ts",
    "preweb:dev": "npm run prepare",
    "web:dev": "vite",
    "preweb:build": "npm run prepare",
    "web:build": "vite build",
    "web:preview": "vite preview"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.2.1"
  }
}
